{
  "private"           : true,
  "name"              : "web",
  "description"       : "",
  "keywords"          : [],
  "license"           : "MIT",
  "homepage"          : "https://polyplate.io/",
  "version"           : "0.0.1",

  "author"            : {
    "name"  : "Selçuk Çukur",
    "email" : "hello@selcukcukur.me",
    "url"   : "https://selcukcukur.me"
  },

  "bugs"              : {
    "email" : "security@polyplate.io",
    "url"   : "https://github.com/polyplate/polyplate/issues"
  },

  "scripts"           : {
    "build"             : "next build",
    "clean"             : "rimraf node_modules dist .next .turbo",
    "dev"               : "next dev --hostname polyplate.dev --experimental-https --experimental-https-key ./certificate/polyplate-key.pem --experimental-https-cert ./certificate/polyplate.pem --turbopack --port 443",
    "lint"              : "next lint",
    "start"             : "next server",
    "test"              : "pnpm db:generate && vitest -no-file-parallelism --bail=1",
    "script"            : "tsx ./scripts/run.ts",
    "db:generate"       : "dotenv-flow -e .env -- pnpm --filter=@polyplate/database generate",
    "db:push"           : "dotenv-flow -e .env -- pnpm --filter=@polyplate/database push",
    "db:studio"         : "dotenv-flow -e .env -- pnpm --filter=@polyplate/database studio",
    "db:format"         : "dotenv-flow -e .env -- pnpm --filter=@polyplate/database format",
    "db:sync"           : "dotenv-flow -e .env -- pnpm --filter=@polyplate/database sync"
  },

  "dependencies"      : {
    "@polyplate/database"     : "workspace:*",
    "@polyplate/interface"    : "workspace:*",
    "@polyplate/translation"  : "workspace:*",
    "@obvia/utilities"        : "^0.0.4",
    "@obvia/fonts"            : "^1.3.0",
    "cmdk"                    : "^1.1.1",
    "motion"                  : "^12.38.0",
    "lucide-react"            : "^1.7.0",
    "next"                    : "catalog:base",
    "next-themes"             : "^0.4.6",
    "react"                   : "catalog:base",
    "react-dom"               : "catalog:base"
  },
  "devDependencies"   : {
    "@obvia/presets"          : "^0.0.2",
    "@types/node"             : "catalog:type",
    "@types/react"            : "catalog:type",
    "@types/react-dom"        : "catalog:type",
    "typescript"              : "catalog:type"
  },

  "publishConfig"     : {
    "access"  : "public"
  },
  "publisher"         : {
    "type" : "github",
    "user" : "polyplate",
    "repo" : "polyplate"
  },
  "repository"        : {
    "type"  : "git",
    "url"   : "git+https://github.com/polyplate/polyplate.git"
  }
}
